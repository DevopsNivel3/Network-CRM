    "@nuxtjs/device": "^3.2.4",
    "@nuxtjs/leaflet": "^1.2.6",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.9.0",
    "@prisma/client": "^6.9.0",
    "@prisma/nuxt": "^0.2.0",
    "@sidebase/nuxt-auth": "^0.10.0",
    "@vueup/vue-quill": "^1.2.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dayjs": "^1.11.13",
    "dayjs-nuxt": "^2.1.11",
    "dotenv": "^17.2.2",
    "echarts": "^5.6.0",
    "element-plus": "^2.11.3",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "6.10.1",
    "nuxt": "^3.15.0",
    "nuxt-booster": "^3.1.10",
    "nuxt-echarts": "^0.3.2",
    "nuxt-file-storage": "^0.2.9",
