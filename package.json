    "@types/bcrypt": "^5.0.2",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.7",
    "node": "^24.0.0",
    "prisma": "^6.9.0",
    "typescript": "~5.7.3",
    "vue-tsc": "~2.1.10"
  }
