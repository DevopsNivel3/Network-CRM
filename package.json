{
  "name": "network-crm",
  "version": "2.4.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "typecheck": "nuxi typecheck",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-nuxt.ps1 build",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-nuxt.ps1 dev",
    "generate": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-nuxt.ps1 generate",
    "preview": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-nuxt.ps1 preview",
    "postinstall": "prisma generate && powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-nuxt.ps1 prepare",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@element-plus/nuxt": "^1.1.1",
    "@nuxt/image": "^1.8.1",
